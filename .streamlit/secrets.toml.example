# Copy this file to .streamlit/secrets.toml for local dev,
# OR paste the key/value into Streamlit Cloud → App settings → Secrets.
#
# How to get your token:
#   1. Log into play.fifa.com/fantasy
#   2. Open DevTools (F12) → Network tab
#   3. Reload the page, filter requests by "fantasy" or "players"
#   4. Click any request → Headers → copy the "Authorization" value
#      It looks like:  Bearer eyJhbGciOiJSUzI1NiJ9...
#
# Once set here you NEVER need to paste it in the app sidebar again.

FIFA_SESSION_TOKEN = "Bearer eyJ..."

# Optional: API-Football key for live club season stats
# API_FOOTBALL_KEY = "your_key_here"
